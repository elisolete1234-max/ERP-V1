#
# Desarrollo local sin variables:
# - la app usa un archivo SQLite local en data/fabriq-erp.db
#
# Produccion / Vercel:
# - define ambas variables para usar Turso
#

TURSO_DATABASE_URL="libsql://tu-base-tu-organizacion.turso.io"
TURSO_AUTH_TOKEN="tu-token-de-turso"

# Recuperacion automatica de contrasena por email
# APP_BASE_URL debe ser la URL publica de la app en produccion.
APP_BASE_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Eli Print 3D <no-reply@eli-print-3d.local>"

