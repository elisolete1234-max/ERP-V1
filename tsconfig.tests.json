{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": ".test-dist",
    "rootDir": ".",
    "noEmit": false,
    "isolatedModules": false,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "app/actions.ts",
    "lib/db.ts",
    "lib/erp-service.ts",
    "types/**/*.d.ts",
    "tests/**/*.ts"
  ]
}
